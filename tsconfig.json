{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"],
      "@css/*": ["src/assets/css/*"],
      "@js/*": ["src/assets/js/*"],
      "@img/*": ["src/assets/img/*"],
      "@layouts/*": ["src/assets/layouts/*"],
      "@components/*": ["src/assets/components/*"],
    }
  }
}
